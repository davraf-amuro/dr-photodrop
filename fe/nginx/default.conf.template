# nginx per dr-photodrop-fe: PWA statica + proxy /api verso l'API.
# Template dell'immagine nginx ufficiale: envsubst sostituisce solo PHOTODROP_* (NGINX_ENVSUBST_FILTER).
# Il token di upload NON viene aggiunto qui: lo invia la PWA (header X-Api-Key, memorizzato sul telefono).
# Vedi piano photo-inbox, rischi: autenticazione con token.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Foto da telefono: il limite effettivo e' applicato dall'API (Inbox:MaxPhotoSizeMb); qui un tetto piu' largo.
    client_max_body_size 25m;

    # DNS interno di Docker: l'API puo' avviarsi dopo di noi senza far fallire nginx all'avvio.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        set $photodrop_api "${PHOTODROP_API_URL}";
        proxy_pass $photodrop_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_request_buffering off;
        add_header Cache-Control "no-store" always;
    }

    # Il service worker non deve restare in cache, altrimenti gli aggiornamenti non arrivano
    location = /sw.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store";
        try_files $uri $uri/ /index.html;
    }
}
