# Configurazione per docker compose: copia in .env (escluso da git) e sostituisci i placeholder.
# Per dotnet run / F5 usa src/dr_photodrop.api/appsettings.local.json.

# Token di upload obbligatorio (header X-Api-Key): senza, l'API non parte. Generane uno casuale, es. in PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
Authentication__ApiKey__ApiKeyValue=<token-upload>

# Limiti di upload (opzionali: i default stanno in appsettings.json)
# Inbox__MaxPhotoSizeMb=10
